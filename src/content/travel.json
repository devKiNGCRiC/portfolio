  "tripToProduct": [
    {
      "step": "The trip",
      "text": "Travelling solo through Uttarakhand to the Valley of Flowers."
    },
    {
      "step": "The problem",
      "text": "Planning meant jumping between blogs, reels and forums, and almost none of it talked about travelling responsibly."
    },
    {
      "step": "The idea",
      "text": "One place for travellers: guides, eco-tourism, community and practical tools."
    },
    {
      "step": "The product",
      "text": "Safarnama, which went on to win the Special Jury Award."
    }
